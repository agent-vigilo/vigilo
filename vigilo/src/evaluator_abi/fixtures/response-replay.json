  {
    "name": "ordered-multimodal-tools",
    "body": "{\"messages\":[{\"text\":\"good\",\"image\":\"AP8=\"},{\"text\":\"excellent\",\"image\":\"AP8=\"}],\"call\":{\"id\":\"call-1\",\"name\":\"lookup\",\"arguments\":\"{ \\\"id\\\": 1 }\"},\"result\":{\"id\":\"call-1\",\"data\":{\"found\":true},\"is_error\":false}}",
    "configuration": {
      "schema_version": "1.0.0",
      "interpretation": {
        "format": "json",
        "mapping": {
          "items": [
            {
              "mode": "each",
              "source": {
                "pointer": "/messages"
              },
              "item": {
                "type": "message",
                "content": [
                  {
                    "media_type": "text/plain",
                    "source": {
                      "representation": "inline_text",
                      "selection": {
                        "pointer": "/text"
                      }
                    }
                  },
                  {
                    "media_type": "image/png",
                    "source": {
                      "representation": "base64",
                      "selection": {
                        "pointer": "/image"
                      }
                    }
                  }
                ]
              }
            },
            {
              "mode": "single",
              "item": {
                "type": "tool_call",
                "call_id": {
                  "pointer": "/call/id"
                },
                "name": {
                  "source": "field",
                  "selection": {
                    "pointer": "/call/name"
                  }
                },
                "arguments": {
                  "media_type": "application/json",
                  "source": {
                    "representation": "json_string",
                    "selection": {
                      "pointer": "/call/arguments"
                    }
                  }
                }
              }
            },
            {
              "mode": "single",
              "item": {
                "type": "tool_result",
                "call_id": {
                  "pointer": "/result/id"
                },
                "content": [
                  {
                    "media_type": "application/json",
                    "source": {
                      "representation": "json_value",
                      "selection": {
                        "pointer": "/result/data"
                      }
                    }
                  }
                ],
                "is_error": {
                  "pointer": "/result/is_error"
                }
              }
            }
          ]
        }
      }
    },
    "expected_sentiment": "positive"
  }
