package vigilo:evaluator@1.0.0;

// data types
interface types {
    record test-case {
        id: string,
        task-type: string,
        case-group: option<string>,
        input-json: string,
        expected-json: option<string>,
        context-json: option<string>,
        tags: list<string>,
        metadata-json: string,
    }

    record tool-call {
        name: string,
        arguments-json: string,
        result-json: option<string>,
    }

    record agent-trace-event {
        kind: string,
        name: option<string>,
        payload-json: string,
    }

    record agent-output {
        text: option<string>,
        structured-json: option<string>,
        tool-calls: list<tool-call>,
        trace: list<agent-trace-event>,
        raw-json: string,
        metadata-json: string,
    }

    // Ordered interpreted evidence. None differs from an observed empty list.
    type resource-handle = u64;
    record body-metadata {
        %resource: resource-handle,
        byte-length: u64,
        content-type: option<string>,
    }
    record body-range { offset: u64, byte-length: u64 }
    record resource-content { handle: resource-handle, byte-length: u64 }
    variant content-source {
        inline-text(string),
        body-range(body-range),
        %resource(resource-content),
    }
    record content-part { media-type: string, source: content-source }
    record message {
        id: option<string>,
        role: option<string>,
        content: list<content-part>,
    }
    record observed-tool-call {
        call-id: option<string>,
        name: string,
        arguments: content-part,
    }
    record tool-result {
        call-id: option<string>,
        content: list<content-part>,
        is-error: option<bool>,
    }
    variant output-item {
        message(message),
        tool-call(observed-tool-call),
        tool-result(tool-result),
    }
    enum completion-status { completed, incomplete, failed }
    enum stop-category { end-turn, tool-call, limit, refusal, other }
    record stop-reason { category: stop-category, provider-value: option<string> }
    record response-evidence {
        schema-version: string,
        body: body-metadata,
        items: option<list<output-item>>,
        status: option<completion-status>,
        stop-reason: option<stop-reason>,
    }
    record evidence-requirements {
        original-body: bool,
        mapped-items: bool,
        content-media-types: list<string>,
        tool-calls: bool,
        tool-results: bool,
    }
    enum resource-read-error { unavailable, invalid-handle, out-of-bounds, limit-exceeded }

    record input {
        run-id: string,
        execution-id: string,
        attempt-id: string,
        test-case: test-case,
        actual: agent-output,
        response-evidence: option<response-evidence>,
        evaluator-config-json: string,
    }

    record evaluator-identity {
        namespace: string,
        name: string,
        version: string,
        content-hash: option<string>,
        interface-version: option<string>,
    }

    enum severity {
        none,
        low,
        medium,
        high,
        critical,
    }

    record numeric-measurement {
        value: f64,
        unit: option<string>,
    }

    variant measurement {
        binary(bool),
        numeric(numeric-measurement),
        ordinal(string),
    }

    record abstention {
        category: string,
        reason: option<string>,
    }

    variant evaluator-outcome {
        completed(measurement),
        abstained(abstention),
    }

    record diagnostic-finding {
        severity: severity,
        category: string,
        reason: option<string>,
        evidence-json: string,
        tags: list<string>,
    }

    record output {
        evaluator: evaluator-identity,
        outcome: evaluator-outcome,
        diagnostics: list<diagnostic-finding>,
        metadata-json: string,
    }

    record evaluator-error {
        code: string,
        message: string,
    }
}

// executor functions exposed to evaluators
interface executor {
    use types.{resource-handle, resource-read-error};
    // Handles are scoped to one evaluate invocation. Reads do not move a cursor.
    // Offset equal to length returns empty bytes; beyond length is out-of-bounds.
    // Zero max-bytes or budget exhaustion returns limit-exceeded.
    read-resource: func(handle: resource-handle, offset: u64, max-bytes: u32) -> result<list<u8>, resource-read-error>;

    // tracing
    trace: func(msg: string);
    debug: func(msg: string);
    warn: func(msg: string);
    error: func(msg: string);

    // http requests
    record http-header {
        name: string,
        value: string,
    }
    record http-request {
        method: string,
        uri: string,
        headers: list<http-header>,
        body: option<list<u8>>,
        timeout-ms: option<u32>,
    }
    record http-response {
        status: u16,
        headers: list<http-header>,
        body: list<u8>,
    }
    // outbound HTTP (host-mediated, policy-controlled)
    send-http-request: func(req: http-request) -> result<http-response, string>;
}

// evaluator interface
interface evaluator {
    use types.{input, output, evaluator-error, evidence-requirements};
    requirements: func() -> evidence-requirements;
    evaluate: func(input: input) -> result<output, evaluator-error>;
}

world evaluator-world {
    import types;
    import executor;
    export evaluator;
}
