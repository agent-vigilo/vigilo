flowchart LR
    input["Submitted dataset"]
    app["Application ingestion and run planning<br/>validation, identity, publication"]
    control[("Control PostgreSQL<br/>references, leases, progress, settlement")]
    adapter["Provider-neutral storage boundary<br/>bounded and verified I/O"]
    blobs[("Object storage<br/>case batches, run plans, indexes, manifests")]
    inspection["Run inspection<br/>identity and preparation progress"]

    input --> app
    app -->|"Publish compact references"| control
    app -->|"Write immutable objects"| adapter
    adapter --> blobs
    control -->|"Read compact progress and references"| inspection
    worker["Workers<br/>verify assigned ranges and frozen configuration"]
    execution[("Execution PostgreSQL<br/>chunks, references, gate counts, results")]
    control -->|"Admit exact plan"| execution
    execution -->|"Chunk leases and immutable references"| worker
    worker -->|"Verified bounded reads"| adapter
    worker -->|"Attempts and results"| execution
