erDiagram
    dataset_uploads ||--o{ dataset_upload_objects : owns
    dataset_uploads ||--o| dataset_catalog : publishes
    dataset_uploads {
        uuid id PK
        text status
        text storage_alias
        text binding_hash
        jsonb identity
        jsonb limits
        integer case_cursor
        integer batch_count
        bigint generation
        uuid lease_owner
        timestamptz leased_until
        timestamptz expires_at
        timestamptz cleanup_after
        timestamptz cleaned_at
    }
    dataset_upload_objects {
        uuid upload_id PK,FK
        text object_key PK
        text kind
        smallint level
        integer range_start
        integer range_end
        jsonb reference
        boolean acknowledged
        boolean cleaned
    }
    dataset_catalog {
        uuid id PK,FK
        text storage_alias
        text binding_hash
        text dataset_hash
        uuid dataset_version_id
        jsonb limits
        jsonb manifest
    }
