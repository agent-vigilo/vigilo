---
config:
  flowchart:
    nodeSpacing: 150
    rankSpacing: 80
  themeVariables:
    edgeLabelBackground: 'transparent'
---
flowchart TD
    Worker([worker message])
    RunGuard{Shared run-state guard}
    Pending[Execution pending]
    Supersede[Mark prior running attempts stale]
    Running[Execution running]
    AttemptRunning[New attempt ID for the same execution]
    AgentAndEvaluators[Invoke agent and run evaluators]
    TerminalGuard{Chunk live and current attempt authoritative?}
    AggregateGuard{Aggregate available or failure transition?}
    AttemptCompleted[Attempt completed]
    ExecutionCompleted[Execution completed]
    AttemptAgentFail[Agent call failed; remote effects may have occurred]
    AttemptEvalFail[Attempt failed evaluation]
    ExecutionFailed[Execution failed]
    Cancel([run cancel])
    ExecutionCancelled[Execution cancelled]
    AttemptCancelled[Attempt cancelled]
    RetryEligible{Failure retryable and attempt budget remains?}
    RetryScheduled[Persist retry_after using backoff and accepted server advice]
    RetryDue{Retry window due and attempts remain?}
    TimedOut[Attempt and execution timed out]
    Awaiting[Awaiting evaluators]
    Resume[Reclaim the original attempt]
    DeferredOutcome{Saved result}
    Settle[Terminal chunk settlement under chunk lock]
    Unresolved[Close unresolved execution without inventing an aggregate]
    Stale[Attempt stale]
    Reject[Reject stale transition]

    Worker --> RunGuard
    RunGuard -- Running --> Pending --> Supersede --> Running --> AttemptRunning
    AttemptRunning -- Inline --> AgentAndEvaluators
    AttemptRunning -- Deferred --> AwaitAgent[Commit intent and await remote outcome]
    AwaitAgent -- Poll or authenticated callback --> Accept{Current invocation and eligible?}
    Accept -- Yes --> Awaiting
    Accept -- Stale or conflicting --> Reject
    AwaitAgent -- Deadline elapsed --> Awaiting
    Awaiting --> Resume --> DeferredOutcome
    DeferredOutcome -- Evidence --> ScoreSaved[Score saved evidence] --> TerminalGuard
    DeferredOutcome -- Failure or timeout --> TerminalGuard
    AwaitAgent --> Cancel
    RunGuard -- Not running --> Reject
    Supersede --> Stale

    AgentAndEvaluators --> TerminalGuard
    TerminalGuard -- Yes --> AggregateGuard
    TerminalGuard -- No --> Stale

    AggregateGuard -- Completed with aggregate --> AttemptCompleted --> ExecutionCompleted
    AggregateGuard -- Agent invocation failed --> AttemptAgentFail --> RetryEligible
    AggregateGuard -- Evaluation or persistence failed --> AttemptEvalFail --> RetryEligible
    AggregateGuard -- Invocation timed out --> TimedOut
    AggregateGuard -- Missing required aggregate --> Reject
    RetryEligible -- Yes --> RetryScheduled
    RetryEligible -- No --> ExecutionFailed
    RetryScheduled --> RetryDue
    RetryDue -- Yes --> Supersede
    RetryDue -- No attempts remain --> ExecutionFailed

    Running --> Cancel
    Pending --> Cancel
    AttemptRunning --> Cancel
    Cancel --> ExecutionCancelled
    Cancel --> AttemptCancelled

    Running --> Settle
    RetryScheduled --> Settle
    Settle --> Stale
    Settle --> Unresolved --> ExecutionFailed


    class Worker,Cancel command
    class RunGuard,Pending,Supersede,Running,AttemptRunning,AgentAndEvaluators,TerminalGuard,AggregateGuard,Awaiting,Resume,DeferredOutcome,ScoreSaved,RetryEligible,RetryScheduled,RetryDue system
    class AttemptCompleted,ExecutionCompleted success
    class AttemptAgentFail,AttemptEvalFail,ExecutionFailed,ExecutionCancelled,AttemptCancelled,TimedOut,Reject error
    class Stale component
