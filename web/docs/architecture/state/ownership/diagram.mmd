    Execute --> GuardChunk

    GuardCreation --> DB
    GuardRun --> DB
    GuardDispatch --> DB
    GuardAdmission --> DB
    GuardChunk --> DB
    GuardAttempt --> DB
    GuardOutbox --> DB
    Publish --> Queue

    class CLI command
    class Coordinator,Worker,GuardCreation,GuardRun,GuardDispatch,GuardAdmission,GuardChunk,GuardAttempt,GuardOutbox system
