config:
  flowchart:
    nodeSpacing: 150
    rankSpacing: 80
  themeVariables:
    edgeLabelBackground: 'transparent'
---
flowchart TD
    CLI[CLI]
    Coordinator[Coordinator]
    Worker[Worker]
    DB[(DB guards)]
    Queue[Message broker]

    RunCreate[Publish immutable plan and record creating checkpoints]
    RunCancel[Cancel run and open work]
    RunRead[Read status, watch, results, export]

    RecoverCreation[Resume requested admission from ready plans]
    Dispatch[Dispatch chunk windows]
    RecoverLeases[Recover expired chunk leases]
    Aggregate[Consume receipts and seal exact shard membership]
    GuardSummary[Nonblocking page claim and atomic consumption checkpoint]
    Finalize[Finalize exact sealed shard set]
    Publish[Publish outbox records as broker messages]

    ChunkClaim[Claim and release chunks]
    Execute[Allocate attempts, schedule retries, and persist results]
    CompleteChunk[Settle chunk and write immutable receipt]

    GuardCreation[Plan generation and live creation lease]
    GuardRun[Run status and lifecycle lease]
    GuardDispatch[Run-shard dispatch cursor]
    GuardAdmission[Local shard admission, write epoch, and mover fence]
    GuardChunk[Chunk status and worker lease]
    GuardAttempt[Current attempt id and attempt number]
    GuardOutbox[Outbox dedupe key and delivery claim token]

    CLI --> RunCreate
