---
config:
  flowchart:
    nodeSpacing: 120
    rankSpacing: 160
  themeVariables:
    fontSize: 18px
    padding: 50
    edgeLabelBackground: 'transparent'
---
flowchart TD
    %% actors
    User(["fa:fa-user <br/> <b>AI Engineer</b> <br/> <small>[Person]</small>"]):::person
    AgentClient(["fa:fa-robot <br/> <b>Agentic Client</b> <br/> <small>[Software System]</small>"]):::actor
    CICD(["fa:fa-gears <br/> <b>CI/CD Runner</b> <br/> <small>[Software System]</small>"]):::actor

    %% components
    CliRouter["fa:fa-terminal <br/> <b>CLI App and Command Router</b> <br/> <small>[Component: Rust / Clap]</small> <br/> <small>Parses global options and dispatches setup, dataset, evaluator, run, database, rebalance, coordinator, and worker commands.</small>"]:::component
    RuntimeContext["fa:fa-layer-group <br/> <b>Runtime Context Provider</b> <br/> <small>[Component: Rust]</small> <br/> <small>Lazily initializes routed database access, storage adapters, messaging, output, registry cache, and Wasm runtime clients.</small>"]:::component
    OutputRenderer["fa:fa-file-lines <br/> <b>Output Renderer</b> <br/> <small>[Component: Rust]</small> <br/> <small>Writes structured command responses as JSON or TOON.</small>"]:::component

    SetupManager["fa:fa-screwdriver-wrench <br/> <b>Setup Manager</b> <br/> <small>[Component: Rust]</small> <br/> <small>Applies embedded schema migrations or an explicit SQL directory validates database placement, and installs the official core evaluator collection unless skipped.</small>"]:::component
    EvaluatorRegistry["fa:fa-box-archive <br/> <b>Evaluator Registry Manager</b> <br/> <small>[Component: Rust]</small> <br/> <small>Publishes, searches, inspects, tests, and changes evaluator registry state.</small>"]:::component
    EvaluatorPreparer["fa:fa-cubes <br/> <b>Evaluator Package Preparer</b> <br/> <small>[Component: Rust / Wasmtime]</small> <br/> <small>Resolves the static ABI adapter registry, typed-links versioned components, and computes artifact metadata.</small>"]:::component

    DatasetIngestion["<b>Dataset Ingestion</b><br/>Bounded preparation, upload progress,<br/>explicit recovery and catalog publication"]:::component
    BlobAdapter["<b>Storage Adapter</b><br/>Verified immutable file I/O<br/>and exact owned cleanup"]:::component
    ObjectStorage[("<b>Object Storage</b><br/>Case batches, run plans, indexes and manifests")]:::component

    RunPlanner["fa:fa-list-check <br/> <b>Run Input Planner</b> <br/> <small>[Component: Rust]</small> <br/> <small>Validates profile and dataset inputs; streams finalized datasets into immutable run plans.</small>"]:::component
    RunValidator["fa:fa-shield-halved <br/> <b>Run Validation Service</b> <br/> <small>[Component: Rust]</small> <br/> <small>Checks policy, resolves exact evaluator artifacts and ABIs, and builds the immutable execution plan.</small>"]:::component
    RunPersistence["fa:fa-database <br/> <b>Run Persistence Workflow</b> <br/> <small>[Component: Rust / SQLx]</small> <br/> <small>Persists compact plan checkpoints, shard assignments, and idempotent execution metadata.</small>"]:::component
    RunQueries["fa:fa-magnifying-glass <br/> <b>Run Query, Export, and Shard Admin Component</b> <br/> <small>[Component: Rust / SQLx]</small> <br/> <small>Serves routed run reads and manages shard route inspection, move, and rebalance operations.</small>"]:::component

    CoordinatorFacade["fa:fa-compass <br/> <b>Coordinator Command Facade</b> <br/> <small>[Component: Rust]</small> <br/> <small>Starts or executes coordinator orchestration cycles.</small>"]:::component
    WorkerFacade["fa:fa-gear <br/> <b>Worker Command Facade</b> <br/> <small>[Component: Rust]</small> <br/> <small>Starts or executes worker processing cycles.</small>"]:::component
    ServiceRunner["fa:fa-rotate <br/> <b>Service Runner</b> <br/> <small>[Component: Rust / Tokio]</small> <br/> <small>Runs long-lived service loops with tick intervals and graceful shutdown.</small>"]:::component

    %% command runtime boundary
    subgraph VigiloRuntime["&nbsp;"]
        CliRouter
        RuntimeContext
        OutputRenderer
        SetupManager
        EvaluatorRegistry
        EvaluatorPreparer
        DatasetIngestion
        BlobAdapter
        RunPlanner
        RunValidator
        RunPersistence
        RunQueries
        CoordinatorFacade
        WorkerFacade
        ServiceRunner
    end
    style VigiloRuntime stroke-dasharray: 5 5,fill:none,stroke:#1168bd,stroke-width:2px

    %% external containers
    Database[("<b>Database Placements</b> <br/> <small>[Container: PostgreSQL]</small> <br/> <small>Store control metadata, creation ledgers, routed execution rows, outbox ledgers, delivery rows, and migrations.</small>")]:::component
    Queue[("<b>Queue</b> <br/> <small>[Container: RabbitMQ]</small> <br/> <small>Distributes run chunk-ready broker messages to workers.</small>")]:::component
    Coordinator["fa:fa-compass <br/> <b>Coordinator</b> <br/> <small>[Container: Rust]</small> <br/> <small>Owns run-creation recovery, dispatch, finalization, and outbox publication.</small>"]:::component
    Worker["fa:fa-gear <br/> <b>Worker</b> <br/> <small>[Container: Rust]</small> <br/> <small>Consumes chunks, invokes the agent target, runs evaluators, and persists results.</small>"]:::component
    EvaluatorPackages["fa:fa-folder-tree <br/> <b>Evaluator Packages</b> <br/> <small>[External Files]</small> <br/> <small>Source evaluator crates or portable Vigilo.toml and Wasm packages.</small>"]:::external

    CliRouter -->|"Uploads, resumes and cleans datasets"| DatasetIngestion
    DatasetIngestion -->|"Persists compact ownership and progress"| Database
    DatasetIngestion --> BlobAdapter
    RunPlanner -->|"Verifies datasets and publishes bounded plan files"| BlobAdapter
    BlobAdapter --> ObjectStorage

    %% edges
    User & AgentClient -->|"Manages evaluators, runs, and services using"| CliRouter
    CICD -->|"Creates runs and gates deployments via"| CliRouter

    CliRouter -->|"Creates shared runtime access through"| RuntimeContext
    CliRouter -->|"Writes command payloads with"| OutputRenderer
    RuntimeContext -->|"Provides output buffer to"| OutputRenderer

    CliRouter -->|"Runs setup commands using"| SetupManager
    CliRouter -->|"Runs evaluator commands using"| EvaluatorRegistry
    CliRouter -->|"Runs run commands using"| RunPlanner
    CliRouter -->|"Runs inspection and placement administration using"| RunQueries
    CliRouter -->|"Starts and runs service mode using"| CoordinatorFacade
    CliRouter -->|"Starts and runs service mode using"| WorkerFacade

    SetupManager -->|"Applies migrations to <br> <small>[SQL/TCP]</small>"| Database

    CliRouter -->|"Creates portable archives locally using"| EvaluatorPreparer
    EvaluatorPreparer -->|"Writes verified portable packages to"| EvaluatorPackages
    EvaluatorRegistry -->|"Prepares packages with"| EvaluatorPreparer
    EvaluatorPackages -->|"Provides manifests and Wasm artifacts to"| EvaluatorPreparer
    EvaluatorRegistry -->|"Reads from and writes to <br> <small>[SQL/TCP]</small>"| Database
    EvaluatorPreparer -->|"Uses Wasm runtime from"| RuntimeContext

    RunPlanner -->|"Validates executability with"| RunValidator
    RunPlanner -->|"Persists planned runs through"| RunPersistence
    RunValidator -->|"Checks evaluator registry and profile data in <br> <small>[SQL/TCP]</small>"| Database
    RunPersistence -->|"Writes compact plan checkpoints and idempotent execution metadata to <br> <small>[SQL/TCP]</small>"| Database
    RunQueries -->|"Reads and updates run state in <br> <small>[SQL/TCP]</small>"| Database
    RunQueries -->|"Writes formatted results using"| OutputRenderer

    CoordinatorFacade -->|"Runs loops and one-shot cycles with"| ServiceRunner
    WorkerFacade -->|"Runs loops and one-shot cycles with"| ServiceRunner
    CoordinatorFacade -->|"Starts and stops service of type"| Coordinator
    WorkerFacade -->|"Starts and stops service of type"| Worker

    RuntimeContext -->|"Opens database connections to <br> <small>[SQL/TCP]</small>"| Database
    RuntimeContext -->|"Opens messaging connections to <br> <small>[AMQP]</small>"| Queue

    %% links
    click Coordinator "/docs/architecture/structure/components/coordinator/"
    click Worker "/docs/architecture/structure/components/worker/"

    CoreReleases["Official evaluator collections<br/>GitHub Releases"]
    SetupManager -->|"Fetches catalog and verified packages over HTTPS"| CoreReleases
    SetupManager -->|"Validates and publishes core evaluators"| EvaluatorRegistry
