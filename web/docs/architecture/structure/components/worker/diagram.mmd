    edgeLabelBackground: 'transparent'
---
flowchart TD
    %% actors
    Vigilo["fa:fa-terminal <br/> <b>Vigilo CLI</b> <br/> <small>[Container: Rust]</small> <br/> <small>Starts the worker loop or one-shot cycle.</small>"]:::component
    Coordinator["fa:fa-compass <br/> <b>Coordinator</b> <br/> <small>[Container: Rust]</small> <br/> <small>Publishes run.chunk.ready broker messages from durable outbox records.</small>"]:::component

    %% components
    CommandFacade["fa:fa-gear <br/> <b>Worker Command Facade</b> <br/> <small>[Component: Rust / Clap]</small> <br/> <small>Selects start or once mode and builds the evaluator loader.</small>"]:::component
    ServiceLoop["fa:fa-rotate <br/> <b>Service Loop Runner</b> <br/> <small>[Component: Rust / Tokio]</small> <br/> <small>Runs the long-lived consumer loop and handles shutdown.</small>"]:::component
    RuntimeContext["fa:fa-layer-group <br/> <b>Runtime Context Access</b> <br/> <small>[Component: Rust]</small> <br/> <small>Provides database, messaging, HTTP, registry cache, and Wasm runtime clients.</small>"]:::component

    WorkerConsumer["fa:fa-inbox <br/> <b>Worker Queue Consumer</b> <br/> <small>[Component: Rust / AMQP]</small> <br/> <small>Fetches one message for once mode or opens a prefetch-limited delivery stream.</small>"]:::component
    MessagingCircuit["fa:fa-shield-halved <br/> <b>Messaging Circuit Admission</b> <br/> <small>[Component: Rust]</small> <br/> <small>Rejects broker operations during outages and admits one bounded recovery probe.</small>"]:::component
    MessageHandler["fa:fa-envelope-open-text <br/> <b>Chunk Message Handler</b> <br/> <small>[Component: Rust]</small> <br/> <small>Parses chunk-ready payloads and routes invalid, stale, successful, and retryable outcomes.</small>"]:::component
    MessageSettlement["fa:fa-check-double <br/> <b>Message Settlement</b> <br/> <small>[Component: Rust / AMQP]</small> <br/> <small>Acknowledges handled messages, delays planned execution retries, or requeues bounded recoverable failures.</small>"]:::component

    ChunkWorkflow["fa:fa-handshake <br/> <b>Chunk Lease Workflow</b> <br/> <small>[Component: Rust / SQLx]</small> <br/> <small>Uses message route hints, validates local write epochs, and claims or settles owned leases.</small>"]:::component
    RunContextCache["fa:fa-boxes-stacked <br/> <b>Run Context Cache</b> <br/> <small>[Component: Rust / Moka]</small> <br/> <small>Caches verified run snapshots and pinned evaluator execution plans.</small>"]:::component
    EvaluatorLoader["fa:fa-cubes <br/> <b>Evaluator Loader Service</b> <br/> <small>[Component: Rust / Wasmtime]</small> <br/> <small>Loads exact pinned artifacts, resolves ABI adapters, and warms prepared evaluators.</small>"]:::component
    CaseBatchLoader["fa:fa-table-list <br/> <b>Case Batch Loader</b> <br/> <small>[Component: Rust / Storage Adapter]</small> <br/> <small>Verifies immutable configuration and assigned case files within byte budgets.</small>"]:::component

    ExecutionProcessor["fa:fa-list-check <br/> <b>Execution Processing Workflow</b> <br/> <small>[Component: Rust / Tokio]</small> <br/> <small>Allocates due attempts under a shared run-state guard, skips retry waits, and runs chunk cases with bounded parallelism.</small>"]:::component
    AgentClient["fa:fa-brain <br/> <b>Agent Invocation Client</b> <br/> <small>[Component: Rust / HTTP]</small> <br/> <small>Sends evaluator-safe case input to the configured target and normalizes agent output.</small>"]:::component
    WasmSemaphore["fa:fa-gauge-high <br/> <b>Wasm Evaluation Semaphore</b> <br/> <small>[Component: Rust / Tokio]</small> <br/> <small>Caps active evaluator invocations across the worker process.</small>"]:::component
    EvaluatorExecutor["fa:fa-microchip <br/> <b>Evaluator Runtime Executor</b> <br/> <small>[Component: Rust / Wasmtime]</small> <br/> <small>Dispatches versioned ABI adapters in fresh stores with memory, fuel, timeout, and log limits.</small>"]:::component
    CompletenessAggregator["fa:fa-list-check <br/> <b>Completeness & Aggregation</b> <br/> <small>[Component: Rust]</small> <br/> <small>Verifies required evaluator scores before calculating authoritative dimension and aggregate scores.</small>"]:::component
    ResultPersistence["fa:fa-database <br/> <b>Result Persistence Workflow</b> <br/> <small>[Component: Rust / SQLx]</small> <br/> <small>Appends evaluator results and upserts aggregates with child-row authority checks.</small>"]:::component
    TerminalTransitions["fa:fa-shield-halved <br/> <b>Terminal Transition Guard</b> <br/> <small>[Component: Rust / SQLx]</small> <br/> <small>Marks attempts completed, retry-scheduled, or terminal only when chunk, current-attempt, and live-lease authority still match.</small>"]:::component

    %% worker boundary
    subgraph WorkerRuntime["&nbsp;"]
        CommandFacade
        ServiceLoop
        RuntimeContext
        WorkerConsumer
        MessagingCircuit
        MessageHandler
