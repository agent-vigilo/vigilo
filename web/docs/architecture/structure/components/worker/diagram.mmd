    end
    style WorkerRuntime stroke-dasharray: 5 5,fill:none,stroke:#1168bd,stroke-width:2px

    %% external containers
    Database[("<b>Database Placements</b> <br/> <small>[Container: PostgreSQL]</small> <br/> <small>Store control evaluator metadata plus routed execution chunks, attempts, results, and aggregates.</small>")]:::component
    Queue[("<b>Queue</b> <br/> <small>[Container: RabbitMQ]</small> <br/> <small>Delivers run.chunk.ready broker messages to workers.</small>")]:::component
    TargetAgent["fa:fa-brain <br/> <b>Agent / AI Provider</b> <br/> <small>[External System]</small> <br/> <small>The model, agent wrapper, or HTTP endpoint being evaluated.</small>"]:::external

    %% edges
    Vigilo -->|"Runs worker start or once through"| CommandFacade
    CommandFacade -->|"Starts continuous mode with"| ServiceLoop
    CommandFacade -->|"Runs one bounded receive pass through"| WorkerConsumer
    ServiceLoop -->|"Maintains delivery stream with"| WorkerConsumer

    CommandFacade -->|"Creates shared access through"| RuntimeContext
    WorkerConsumer -->|"Uses messaging client from"| RuntimeContext
    MessageHandler -->|"Uses database and messaging clients from"| RuntimeContext
    AgentClient -->|"Uses shared HTTP client from"| RuntimeContext
    EvaluatorLoader -->|"Uses registry cache and Wasm runtime from"| RuntimeContext
    EvaluatorExecutor -->|"Uses Wasm runtime from"| RuntimeContext

    Coordinator -->|"Publishes chunk-ready broker messages to <br> <small>[JSON/AMQP]</small>"| Queue
    RuntimeContext -->|"Provides broker policy to"| MessagingCircuit
    RuntimeContext -->|"Opens database access to <br> <small>[SQL/TCP]</small>"| Database

    WorkerConsumer -->|"Delivers messages to"| MessageHandler
    MessageHandler -->|"Claims chunk ownership with"| ChunkWorkflow
    ChunkWorkflow -->|"Reads and updates chunk leases in <br> <small>[SQL/TCP]</small>"| Database

    MessageHandler -->|"Loads verified profile and execution plan through"| RunContextCache
    RunContextCache -->|"Reads compact immutable references from <br> <small>[SQL/TCP]</small>"| Database
    RunContextCache -->|"Warms pinned evaluator artifacts with"| EvaluatorLoader
    EvaluatorLoader -->|"Reads exact evaluator Wasm by pinned id and hash from <br> <small>[SQL/TCP]</small>"| Database

    MessageHandler -->|"Loads cases with"| CaseBatchLoader
    Objects[("Object storage<br/>Immutable plans and dataset files")]:::component
    InputByteCache["<b>Immutable Input Byte Cache</b><br/>Command-owned; shared across shard contexts.<br/>8 MiB charged / 256 entries / files up to 1 MiB.<br/>Binding and full-reference isolation; validation on every use."]:::component
    CaseBatchLoader -->|"Read complete case and plan files"| InputByteCache
    RunContextCache -->|"Read frozen configuration"| InputByteCache
    InputByteCache -->|"Bounded verified reads on miss"| Objects
    MessageHandler -->|"Processes claimed case batch with"| ExecutionProcessor

    ExecutionProcessor -->|"Invokes agent for chunk cases with bounded concurrency through"| AgentClient
    AgentClient -->|"Sends case input and receives output from <br> <small>[TEXT/HTTP]</small>"| TargetAgent
    ExecutionProcessor -->|"Acquires active-evaluation permits from"| WasmSemaphore
    WasmSemaphore -->|"Admits bounded evaluator calls into"| EvaluatorExecutor
    EvaluatorExecutor -->|"Gets prepared evaluators from"| EvaluatorLoader
    EvaluatorExecutor -->|"Returns one measurement or abstention plus diagnostics to"| CompletenessAggregator
    ExecutionProcessor -->|"Provides the resolved binding plan to"| CompletenessAggregator
    CompletenessAggregator -->|"Applies binding policy and supplies authoritative results to"| ResultPersistence
    ResultPersistence -->|"Appends invocation results and diagnostics, then upserts aggregates in <br> <small>[SQL/TCP]</small>"| Database
    MessageHandler -->|"Applies terminal execution updates with"| TerminalTransitions
    TerminalTransitions -->|"Updates attempts and executions with authority checks in <br> <small>[SQL/TCP]</small>"| Database

    MessageHandler -->|"Completes or releases owned chunk through"| ChunkWorkflow
    MessageHandler -->|"Settles delivery with"| MessageSettlement
    WorkerConsumer -->|"Requests receive admission from"| MessagingCircuit
    MessageSettlement -->|"Requests retry and quarantine publish admission from"| MessagingCircuit
    MessagingCircuit -->|"Admits closed or half-open operations over <br> <small>[AMQP]</small>"| Queue
    MessageSettlement -->|"Acknowledges handled messages over <br> <small>[AMQP]</small>"| Queue

    Settlement["<b>Chunk Settlement</b><br/>Fence remaining writers and commit terminal chunk receipt."]:::component
    MessageHandler --> Settlement
    Settlement --> Database

