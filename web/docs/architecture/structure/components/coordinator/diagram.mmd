config:
  flowchart:
    nodeSpacing: 120
    rankSpacing: 160
  themeVariables:
    fontSize: 18px
    padding: 50
    edgeLabelBackground: 'transparent'
---
flowchart TD
    %% actors
    Vigilo["fa:fa-terminal <br/> <b>Vigilo CLI</b> <br/> <small>[Container: Rust]</small> <br/> <small>Starts the coordinator loop or one-shot cycle.</small>"]:::component
    Worker["fa:fa-gear <br/> <b>Worker</b> <br/> <small>[Container: Rust]</small> <br/> <small>Consumes chunk-ready broker messages and persists execution outcomes.</small>"]:::component

    %% components
    CommandFacade["fa:fa-compass <br/> <b>Coordinator Command Facade</b> <br/> <small>[Component: Rust / Clap]</small> <br/> <small>Selects start or once mode, loads throughput knobs, and creates a coordinator identity.</small>"]:::component
    ServiceLoop["fa:fa-rotate <br/> <b>Service Loop Runner</b> <br/> <small>[Component: Rust / Tokio]</small> <br/> <small>Runs coordinator cycles on a fixed tick and handles shutdown.</small>"]:::component
    RuntimeContext["fa:fa-layer-group <br/> <b>Runtime Context Access</b> <br/> <small>[Component: Rust]</small> <br/> <small>Provides database and messaging clients for each cycle.</small>"]:::component

    CycleOrchestrator["fa:fa-arrows-spin <br/> <b>Coordinator Cycle Orchestrator</b> <br/> <small>[Component: Rust]</small> <br/> <small>Runs creation recovery, lease recovery, dispatch, receipt aggregation, finalization, outbox publication, and timing logs in deterministic order.</small>"]:::component
    CreationRecovery["fa:fa-database <br/> <b>Run Creation Recovery</b> <br/> <small>[Component: Rust / SQLx]</small> <br/> <small>Claims stale creating runs, resumes idempotent placement seeds, and activates fully seeded runs.</small>"]:::component
    LeaseRecovery["fa:fa-life-ring <br/> <b>Chunk Lease Recovery</b> <br/> <small>[Component: Rust / SQLx]</small> <br/> <small>Recovers expired chunk leases or marks poison chunks failed after the recovery limit.</small>"]:::component
    DispatchPass["fa:fa-list-check <br/> <b>Dispatch Pass</b> <br/> <small>[Component: Rust]</small> <br/> <small>Bounds chunk-window dispatch work and logs cursor backlog per coordinator cycle.</small>"]:::component
    DispatchWorkflow["fa:fa-share-nodes <br/> <b>Run Dispatch Workflow</b> <br/> <small>[Component: Rust / SQLx]</small> <br/> <small>Claims a control cursor, prepares an execution snapshot, and inserts one run.chunk.ready outbox record per selected chunk.</small>"]:::component

    ReceiptAggregation["<b>Receipt Aggregation</b><br/>Drains ready work in fair rounds with page and time budgets, bounded shard/database concurrency, and one atomic checkpoint per page."]:::component
    FinalizationPass["fa:fa-flag-checkered <br/> <b>Finalization Pass</b> <br/> <small>[Component: Rust]</small> <br/> <small>Bounds finalizable-run work and logs candidate backlog per coordinator cycle.</small>"]:::component
    FinalizeWorkflow["fa:fa-calculator <br/> <b>Run Finalization Workflow</b> <br/> <small>[Component: Rust / SQLx]</small> <br/> <small>Merges bounded shard scorecards, applies run gates, and commits the scorecard, gate status, and completion event.</small>"]:::component

    OutboxPublisher["fa:fa-paper-plane <br/> <b>Outbox Publisher</b> <br/> <small>[Component: Rust / Tokio]</small> <br/> <small>Claims delivery batches, logs per-placement backlog, publishes with bounded concurrency, and deletes completed rows.</small>"]:::component
    EventPublisher["fa:fa-plug <br/> <b>Event Publisher Boundary</b> <br/> <small>[Component: Rust Trait]</small> <br/> <small>Separates durable outbox handling from the broker transport.</small>"]:::component
    MessagingCircuit["fa:fa-shield-halved <br/> <b>Messaging Circuit Admission</b> <br/> <small>[Component: Rust]</small> <br/> <small>Rejects broker operations during outages and admits one bounded recovery probe.</small>"]:::component
    MqPublisher["fa:fa-envelope-open-text <br/> <b>RabbitMQ Event Publisher</b> <br/> <small>[Component: Rust / AMQP]</small> <br/> <small>Declares durable topology and publishes persistent mandatory JSON events with confirms.</small>"]:::component

    %% coordinator boundary
    subgraph CoordinatorRuntime["&nbsp;"]
        CommandFacade
        ServiceLoop
        RuntimeContext
        CycleOrchestrator
        CreationRecovery
        LeaseRecovery
        DispatchPass
        DispatchWorkflow
        ReceiptAggregation
        FinalizationPass
        FinalizeWorkflow
        OutboxPublisher
        EventPublisher
        MessagingCircuit
        MqPublisher
    end
    style CoordinatorRuntime stroke-dasharray: 5 5,fill:none,stroke:#1168bd,stroke-width:2px

    %% external containers
    Database[("<b>Database Placements</b> <br/> <small>[Container: PostgreSQL]</small> <br/> <small>Store creation plans, control cursors, routed execution rows, shard summaries, local outbox records, and delivery queues.</small>")]:::component
    Queue[("<b>Queue</b> <br/> <small>[Container: RabbitMQ]</small> <br/> <small>Durably stores routed run lifecycle and chunk-ready broker messages.</small>")]:::component

    %% edges
    Vigilo -->|"Runs coordinator start or once through"| CommandFacade
    CommandFacade -->|"Starts continuous mode with"| ServiceLoop
    CommandFacade -->|"Runs one cycle through"| CycleOrchestrator
    ServiceLoop -->|"Invokes on each tick"| CycleOrchestrator

    CycleOrchestrator -->|"Acquires clients from"| RuntimeContext
    RuntimeContext -->|"Opens database access to <br> <small>[SQL/TCP]</small>"| Database
    RuntimeContext -->|"Provides broker policy to"| MessagingCircuit

    CycleOrchestrator -->|"First resumes"| CreationRecovery
    CreationRecovery -->|"Claims control plans, seeds execution rows, and activates complete runs in <br> <small>[SQL/TCP]</small>"| Database

    CycleOrchestrator -->|"Then recovers"| LeaseRecovery
    LeaseRecovery -->|"Resets expired leases, inserts recovery events, or settles exhausted chunks with receipts in <br> <small>[SQL/TCP]</small>"| Database

    CycleOrchestrator -->|"Then dispatches with"| DispatchPass
    DispatchPass -->|"Claims one dispatchable chunk window with"| DispatchWorkflow
    DispatchWorkflow -->|"Claims one control cursor, then updates execution-local chunks, snapshots, outbox records, and delivery rows in <br> <small>[SQL/TCP]</small>"| Database

    CycleOrchestrator -->|"Then aggregates receipts with"| ReceiptAggregation
    ReceiptAggregation -->|"Per-page claims, ownership fences, and resumable seals in"| Database
    CycleOrchestrator -->|"Then finalizes"| FinalizationPass
    FinalizationPass -->|"Claims and finalizes one terminal run at a time with"| FinalizeWorkflow
    FinalizeWorkflow -->|"Reads summaries by database, validates exact shard seals, and atomically stores the final scorecard and run outcome in <br> <small>[SQL/TCP]</small>"| Database

    CycleOrchestrator -->|"Finally publishes with"| OutboxPublisher
    OutboxPublisher -->|"Claims delivery rows, marks ledgers, deletes completed rows, and reschedules retries in <br> <small>[SQL/TCP]</small>"| Database
    OutboxPublisher -->|"Publishes claimed event records concurrently through"| EventPublisher
    EventPublisher -->|"Requests broker admission from"| MessagingCircuit
    MessagingCircuit -->|"Admits closed or half-open operations to"| MqPublisher
    MqPublisher -->|"Publishes persistent routed run messages to <br> <small>[JSON/AMQP]</small>"| Queue
    Queue -->|"Delivers run.chunk.ready messages to"| Worker

