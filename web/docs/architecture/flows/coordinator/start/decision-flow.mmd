---
config:
  flowchart:
    nodeSpacing: 150
    rankSpacing: 80
  themeVariables:
    edgeLabelBackground: 'transparent'
---
flowchart TD
    Start([vigilo coordinator start])

    CoordinatorId[Generate coordinator id]
    Runner[Start coordinator service runner]
    Event{Next service event?}
    Database{Database context available?}
    RecoverCreation[Claim ready plans with execution requested]
    ReadPlan[Verify immutable roots, configuration and gate counts]
    AdmitPlan[Replay compact admission and verify coverage]
    CreationDeferred[Release ownership and continue bounded candidates]
    Circuit{Alias circuit admits operation?}
    CircuitSkip[Leave durable work pending and continue]
    Recover[Recover expired chunk leases]
    RecoveryIsolated[Count placement failure and continue aliases]
    Dispatch[Dispatch ready run-shard windows]
    DispatchIsolated[Leave cursor open and exclude failed alias]
    Finalize[Read summaries by database and finalize exact valid seals]
    FinalizeIsolated[Defer candidate; inspect next run]
    Aggregate[Discover ready shards with bounded database and shard concurrency]
    AggregationBudget{Ready page and database scheduling budgets available?}
    AggregationPage[Try claim and atomically commit one bounded receipt or canonical page]
    AggregationNext[Visit unchecked candidates before revisiting shards with ready work]
    AggregationDrain[Await all admitted page operations under database deadlines]
    Messaging{Messaging context available?}
    Outbox[Claim delivery queue batch and publish with bounded concurrency]
    BrokerCircuit{Messaging circuit admits publish?}
    OutboxIsolated[Count placement failure and continue aliases]
    Wait[Wait for next tick]
    Shutdown[Cancel service loop]
    Stop{Service stopped in time?}

    Success([Success response])

    ContextFail([Runtime context error])
    CycleFail([Coordinator cycle error])
    ShutdownFail([Shutdown error])

    Start --> CoordinatorId
    CoordinatorId --> Runner
    Runner --> Event

    Event -- Tick elapsed --> Database
    Event -- Shutdown signal --> Shutdown

    Database -- No --> ContextFail
    Database -- Yes --> RecoverCreation

    RecoverCreation --> ReadPlan --> AdmitPlan --> RecoveryPlacement{Serviceable placements remain?}
    ReadPlan -. Unavailable or invalid object .-> CreationDeferred
    AdmitPlan -. Candidate fails .-> CreationDeferred
    CreationDeferred --> RecoveryPlacement
    RecoveryPlacement -- Yes --> Circuit
    RecoveryPlacement -- No --> Dispatch
    Circuit -- Open --> CircuitSkip
    Circuit -- Closed or probe --> Recover
    CircuitSkip --> RecoveryPlacement
    RecoverCreation -. Control recovery fails .-> CycleFail

    Recover --> RecoveryPlacement
    Recover -. Placement operation fails .-> RecoveryIsolated
    RecoveryIsolated --> RecoveryPlacement

    Dispatch --> Aggregate
    Aggregate --> AggregationBudget
    AggregationBudget -- Yes --> AggregationPage --> AggregationNext --> AggregationBudget
    AggregationBudget -- No --> AggregationDrain --> Finalize
    Dispatch -. Execution placement fails .-> DispatchIsolated
    Dispatch -. Control dispatch fails .-> CycleFail
    DispatchIsolated --> Dispatch

    Finalize --> Messaging
    Finalize -. Summary unavailable, open, or invalid .-> FinalizeIsolated
    Finalize -. Control finalization fails .-> CycleFail
    FinalizeIsolated --> Finalize

    Messaging -- No --> ContextFail
    Messaging -- Yes --> Outbox

    Outbox --> BrokerCircuit
    BrokerCircuit -- Open --> Wait
    BrokerCircuit -- Closed or probe --> Wait
    Outbox -. Placement operation fails .-> OutboxIsolated
    Outbox -. Placement catalog fails .-> CycleFail
    OutboxIsolated --> Outbox

    Wait --> Event

    Shutdown --> Stop
    Shutdown -. Shutdown hook fails .-> ShutdownFail

    Stop -- Yes --> Success
    Stop -- No --> ShutdownFail

    class Start command
    class Success success
    class CoordinatorId,Runner,Event,Database,RecoverCreation,ReadPlan,AdmitPlan,CreationDeferred,RecoveryPlacement,Circuit,CircuitSkip,Recover,RecoveryIsolated,Dispatch,DispatchIsolated,Aggregate,AggregationBudget,AggregationPage,AggregationNext,AggregationDrain,Finalize,FinalizeIsolated,Messaging,Outbox,BrokerCircuit,OutboxIsolated,Wait,Shutdown,Stop system
    class ContextFail,CycleFail,ShutdownFail error
