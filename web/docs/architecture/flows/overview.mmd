---
config:
  flowchart:
    nodeSpacing: 150
    rankSpacing: 80
  themeVariables:
    edgeLabelBackground: 'transparent'
---
flowchart TD
    Command([User command])
    Family{Command family}

    Setup[Setup command]
    Dataset[Dataset commands]
    Databases[Database commands]
    Rebalance[Rebalance commands]
    Evaluators[Evaluator commands]
    Runs[Run commands]
    Coordinator[Coordinator commands]
    Worker[Worker commands]

    Decision{Decision flow}
    Execution[Vigilo execution flow]

    Contracts[Runtime contracts]
    DB[(DB)]
    Broker[Message broker]
    Artifacts[Evaluator artifacts]
    Storage[Immutable dataset and run-plan storage]

    Success[Success response]
    Failure[Error response]

    Command --> Family
    Family --> Setup
    Family --> Dataset
    Family --> Databases
    Family --> Rebalance
    Family --> Evaluators
    Family --> Runs
    Family --> Coordinator
    Family --> Worker

    Setup --> Decision
    Dataset --> Decision
    Databases --> Decision
    Rebalance --> Decision
    Evaluators --> Decision
    Runs --> Decision
    Coordinator --> Decision
    Worker --> Decision

    Decision --> Execution
    Execution --> Contracts
    Execution --> DB
    Execution --> Broker
    Execution --> Artifacts
    Execution --> Storage

    Contracts --> Success
    DB --> Success
    Broker --> Success
    Artifacts --> Success
    Storage --> Success

    Decision --> Failure
    Execution --> Failure

    class Command command
    class Family,Decision,Execution,Contracts,DB system
    class Setup,Dataset,Databases,Rebalance,Evaluators,Runs,Coordinator,Worker component
    class Broker,Artifacts,Storage external
    class Success success
    class Failure error
