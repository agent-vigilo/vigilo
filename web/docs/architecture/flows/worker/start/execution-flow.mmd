---
config:
  flowchart:
    nodeSpacing: 150
    rankSpacing: 80
  themeVariables:
    edgeLabelBackground: 'transparent'
---
sequenceDiagram
    actor User
    participant Vigilo
    participant Queue as RabbitMQ
    participant ControlDB as Control DB
    participant Objects as Object Storage
    participant ExecutionDB as Execution DB
    participant Credentials as Credential Provider
    participant Agent as Agent Target
    participant WASM as Wasm Runtime

    User->>Vigilo: vigilo worker start
    activate Vigilo
    Vigilo->>Vigilo: Build evaluator loader and start worker service
    Vigilo->>Vigilo: Acquire messaging circuit admission
    alt Messaging circuit is open or connection fails
        Vigilo->>Vigilo: Wait with bounded reconnect backoff and retry
    else Circuit is closed or half-open probe
        Vigilo->>Queue: Open worker consumer stream
        Queue-->>Vigilo: Delivery stream
    end

    loop Until shutdown or service failure
        alt Shutdown signal received
            User->>Vigilo: Shutdown signal
            Vigilo->>Vigilo: Cancel consumer loop and wait for service stop
            Vigilo-->>User: Success response
        else Delivery received
            Queue-->>Vigilo: Chunk-ready message with alias and write epoch
            Vigilo->>Vigilo: Deserialize message payload
            Vigilo->>ExecutionDB: Validate local admission and claim chunk lease
            ExecutionDB-->>Vigilo: Claimed chunk or no claim

            opt Route hint rejected
                Vigilo->>ControlDB: Refresh authoritative route once
                ControlDB-->>Vigilo: Current alias, lifecycle, and write epoch
                Vigilo->>ExecutionDB: Validate refreshed admission and retry claim
            end

            alt Chunk claimed
                Vigilo->>ExecutionDB: Extend chunk lease and start heartbeat
                Vigilo->>ExecutionDB: Read compact snapshot and immutable plan reference
                ExecutionDB-->>Vigilo: Compact plan, binding and gate metadata
                Vigilo->>Vigilo: Look up exact binding and file references in bounded byte cache
                opt Cache miss or file over 1 MiB
                    Vigilo->>Objects: Read required configuration, plan and case files
                    Objects-->>Vigilo: Immutable complete file bytes
                end
                Vigilo->>Vigilo: Verify bytes and retain eligible files within shared cache bounds
                Vigilo->>Vigilo: Verify complete files and exact assigned case membership
                Vigilo->>ControlDB: Fetch pinned evaluator artifacts by database id
                ControlDB-->>Vigilo: Exact artifact and ABI records
                Vigilo->>WASM: Warm evaluator components
                WASM-->>Vigilo: Warmup result
                Vigilo->>Queue: Hold delivery unacked while chunk is owned
                par Agent calls
                    Vigilo->>Vigilo: Validate profile byte limits against worker ceilings
                    opt Profile references a credential
                        Vigilo->>Credentials: Resolve trusted binding with runtime IDs and destination
                        Credentials-->>Vigilo: Transient header or typed failure
                    end
                    alt Request and credential validation succeed
                        Vigilo->>Agent: Invoke bounded request with attempt correlation and authorized credential
                        Agent-->>Vigilo: Read bounded responses; capture status, HTTP latency, supported usage and Retry-After
                    else Validation or credential resolution fails
                        Vigilo->>Vigilo: Retain bounded failure diagnostics and skip the agent call
                    end
                and Evaluator calls
                    Vigilo->>Vigilo: Acquire Wasm evaluation semaphore permits
                    Vigilo->>WASM: Dispatch pinned ABI adapters in sandboxed stores
                end
                WASM-->>Vigilo: Evaluation outputs
                Vigilo->>ExecutionDB: Persist batched results and lease-guarded terminal transitions with invocation diagnostics
                Vigilo->>ExecutionDB: Read chunk execution retry state
                ExecutionDB-->>Vigilo: Terminal or retry-waiting chunk state
                alt Executions still waiting for retry
                    Vigilo->>ExecutionDB: Release chunk lease
                    Vigilo->>Queue: Delay message until retry window
                else All executions terminal
                    Vigilo->>ExecutionDB: Complete chunk and commit immutable settlement receipt
                    Vigilo->>Queue: Acknowledge message
                end
            else Invalid payload or unclaimable chunk
                Vigilo->>Queue: Acknowledge duplicate or invalid message
            else Recoverable processing failure
                Vigilo->>ExecutionDB: Release chunk lease
                Vigilo->>Queue: Requeue or acknowledge message
            end
        else Consumer stream closed
            Vigilo->>Vigilo: Invalidate session and wait with bounded backoff
            Vigilo->>Vigilo: Acquire messaging circuit admission
            Vigilo->>Queue: Reopen worker consumer stream when admitted
        else Delivery or service fails
            Vigilo-->>User: Service error
        end
    end
    deactivate Vigilo
