flowchart TD
    start["CLI or library test"] --> input{"Bounded valid test input?"}
    input -->|No| fail["Explicit test error"]
    input -->|Yes| read["Scoped artifact read; release database connection"]
    read --> allowed{"Accessible and testable state?"}
    allowed -->|No| fail
    allowed -->|Yes| verify{"Digest and exact supported ABI valid?"}
    verify -->|No| fail
    verify -->|Yes| configured{"Host test resolver configured?"}
    configured -->|No| offline["HTTP unavailable"]
    configured -->|Yes| authority{"Matching authority before deadline?"}
    authority -->|No| fail
    authority -->|Yes| online["Core HTTP session with immutable rules and budgets"]
    online --> execute["Blocking Wasm execution under shared admission"]
    offline --> execute
    execute --> identity{"Returned identity matches registry?"}
    identity -->|No| fail
    identity -->|Yes| output["Return native output; no scoring normalization"]
    execute -->|"Cancellation, trap or deadline"| fail
