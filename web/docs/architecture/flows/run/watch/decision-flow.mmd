---
config:
  flowchart:
    nodeSpacing: 150
    rankSpacing: 80
  themeVariables:
    edgeLabelBackground: 'transparent'
---
flowchart TD
    Start([vigilo run watch])

    RunId{Run id valid?}
    LoadRun[Load status projection]
    Found{Run exists?}
    Progress[Read creation progress or batch shard summaries by database]
    Emit{Control or live progress changed?}
    Write[Write watch update]
    Terminal{Terminal status?}
    Outcome{Terminal outcome accepted?}
    Deadline{Timeout reached?}
    Wait[Wait for next poll interval]
    Reload[Reload status projection]

    Success([Success response])

    RunIdFail([Run id error])
    NotFoundFail([Run not found error])
    OutputFail([Output write error])
    TerminalFail([Watch error])
    TimeoutFail([Timeout error])
    ReloadFail([Run lookup error])

    Start --> RunId

    RunId -- No --> RunIdFail
    RunId -- Yes --> LoadRun

    LoadRun --> Found
    LoadRun -. Lookup fails .-> ReloadFail

    Found -- No --> NotFoundFail
    Found -- Yes --> Progress

    Progress --> Emit
    Progress -. Lookup fails .-> ReloadFail

    Emit -- Yes --> Write
    Emit -- No --> Terminal

    Write --> Terminal
    Write -. Write fails .-> OutputFail

    Terminal -- Yes --> Outcome
    Terminal -- No --> Deadline

    Outcome -- Yes --> Success
    Outcome -- No --> TerminalFail

    Deadline -- Yes --> TimeoutFail
    Deadline -- No --> Wait

    Wait --> Reload
    Reload --> Progress
    Reload -. Lookup fails .-> ReloadFail

    class Start command
    class Success success
    class RunId,LoadRun,Found,Progress,Emit,Write,Terminal,Outcome,Deadline,Wait,Reload system
    class RunIdFail,NotFoundFail,OutputFail,TerminalFail,TimeoutFail,ReloadFail error
