---
config:
  flowchart:
    nodeSpacing: 150
    rankSpacing: 80
  themeVariables:
    edgeLabelBackground: 'transparent'
---
sequenceDiagram
    actor User
    participant Vigilo
    participant ControlDB as Control DB
    participant ExecDB as Execution DBs

    User->>Vigilo: vigilo run watch
    activate Vigilo
    Vigilo->>Vigilo: Parse run id and prepare watch loop
    Vigilo->>ControlDB: Load run status projection
    alt Run is creating or failed during creation
        ControlDB-->>Vigilo: Run and placement creation progress
    else Run was activated
        Vigilo->>ExecDB: Read routed shard summaries in one batch per database
        ExecDB-->>Vigilo: Run and live execution progress
    end

    loop Until terminal status or timeout
        Vigilo->>Vigilo: Compare control and live-progress snapshot
        alt Snapshot changed or terminal
            Vigilo-->>User: Watch update
        end

        alt Run is terminal
            Vigilo->>Vigilo: Evaluate terminal status and gate outcome
            alt Terminal outcome accepted
                Vigilo-->>User: Success response
            else Terminal outcome rejected
                Vigilo-->>User: Watch error
            end
        else Watch timed out
            Vigilo-->>User: Timeout error
        else Run is still active
            Vigilo->>Vigilo: Wait for next poll interval
            Vigilo->>ControlDB: Reload run status projection
            alt Run is creating or failed during creation
                ControlDB-->>Vigilo: Refreshed placement creation progress
            else Run was activated
                Vigilo->>ExecDB: Read latest routed summaries in one batch per database
                ExecDB-->>Vigilo: Refreshed live execution progress
            end
        end
    end
    deactivate Vigilo
