---
config:
  flowchart:
    nodeSpacing: 150
    rankSpacing: 80
  themeVariables:
    edgeLabelBackground: 'transparent'
---
flowchart TD
    Start([vigilo run status])

    RunId{Run id valid?}
    LoadRun[Load control run]
    Creating{Creating or creation-failed?}
    Creation[Read control creation progress]
    Routes[Load execution routes]
    Summaries[Read routed shard summaries in one batch per database]
    Terminal[Mark terminal status]
    Payload[Build status payload with live progress]

    Success([Success response])

    RunIdFail([Run id error])
    NotFoundFail([Run not found error])
    OutputFail([Output write error])

    Start --> RunId

    RunId -- No --> RunIdFail
    RunId -- Yes --> LoadRun

    LoadRun --> Creating
    LoadRun -. Lookup fails .-> NotFoundFail

    Creating -- Yes --> Creation --> Terminal
    Creating -- No --> Routes --> Summaries
    Summaries --> Terminal
    Summaries -. Lookup fails .-> NotFoundFail

    Terminal --> Payload
    Payload --> Success
    Payload -. Write fails .-> OutputFail

    class Start command
    class Success success
    class RunId,LoadRun,Creating,Creation,Routes,Summaries,Terminal,Payload system
    class RunIdFail,NotFoundFail,OutputFail error
